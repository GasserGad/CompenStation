# Copy to .env for local development. Never commit .env.

# PostgreSQL connection string (Neon: copy the "pooled" connection string).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/compenstation
# Set to true for hosted databases that need TLS (always on when NODE_ENV=production).
DATABASE_SSL=false

PORT=3000
# The exact address people use to open the site. Required (https) in production.
PUBLIC_ORIGIN=http://localhost:3000
# Number of proxies in front of the app (Render = 1). Leave 0 locally.
TRUST_PROXY=0

# Public demo: fictional data, reset on start and every DEMO_RESET_HOURS.
DEMO_MODE=true
DEMO_RESET_HOURS=6
DEMO_PASSWORD=CompenDemo!2026

SESSION_HOURS=8
GLOBAL_RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_15_MIN=10
